@using DeVesen.Bazaar.Client.Models
@using DeVesen.Bazaar.Client.State.Title
@using DeVesen.Bazaar.Client.Components.Common.TextField
@using DeVesen.Bazaar.Client.Components.ArticleCategory

@page "/article-category"
@attribute [Authorize]

@inject TitleFacade TitleFacade
@inject Services.DialogService DialogService

<div class="h-100 d-flex flex-column gap-3">
    <div class="d-flex gap-3">
        <DvTextField T="string"
                     Label="Suche"
                     FullWidth="true"
                     Clearable="true"
                     @bind-Value="@SearchText" />
        <MudButton StartIcon="@Icons.Material.TwoTone.NoteAdd"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateArticleCategoryAsync">Neu</MudButton>
    </div>

    <ArticleCategoryList SearchText="@SearchText"
                         OnElementSelected="ModifyArticleCategoryAsync" />
</div>

@code {

    private string? SearchText { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        TitleFacade.SetCaption("Kategorien");
    }

    private async Task CreateArticleCategoryAsync()
    {
        await DialogService.CreateArticleCategoryAsync();
    }

    private async Task ModifyArticleCategoryAsync(ArticleCategory element)
    {
        await DialogService.ModifyArticleCategoryAsync(element);
    }
}
