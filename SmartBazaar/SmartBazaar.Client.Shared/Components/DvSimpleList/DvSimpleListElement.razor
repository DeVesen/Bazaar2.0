
<style>
    .simple-list-item {
        height: 70px;
    }

    .simple-list-item:hover {
        background-color: #cccccc !important;
    }
</style>

<MudButton FullWidth
           Variant="Variant.Filled"
           Class="simple-list-item"
           OnClick="ModifyElementAsync">
    <div class="p-1 d-flex flex-grow-1 gap-2">
        @if (HasImage)
        {
            <div class="align-content-center">
                <div style="width: 40px; height: 40px;">
                    <MudImage Src="@Element.ImgSrc"
                              ObjectFit="ObjectFit.Contain"
                              Width="40" Height="40"/>
                </div>
            </div>
        }
        <div class="flex-grow-1 align-content-center">
            <MudText>@Element.Title</MudText>
        </div>
    </div>
</MudButton>

@code {
    private bool HasImage => string.IsNullOrWhiteSpace(Element.ImgSrc) is false;

    [Parameter, EditorRequired] public DvSimpleList.Element Element { get; set; } = null!;

    [Parameter, EditorRequired] public EventCallback<DvSimpleList.Element> ElementSelected { get; set; }

    private async Task ModifyElementAsync()
    {
        await ElementSelected.InvokeAsync(Element);
    }
}
