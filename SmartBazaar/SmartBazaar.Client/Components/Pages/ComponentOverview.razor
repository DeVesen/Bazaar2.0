@using SmartBazaar.Client.Components.Layout
@using SmartBazaar.Client.Components.ComponentOverview
@using SmartBazaar.Client.Components.ArticleBrand
@using SmartBazaar.Client.Services
@using SmartBazaar.Client.Components.ArticleCategory
@using SmartBazaar.Client.States.ArticleCategoryState
@using SmartBazaar.Client.Components.Dealer
@using SmartBazaar.Client.Components.Article
@using SmartBazaar.Client.States.ArticleState
@using SmartBazaar.Client.States.DealerInfoState

@layout ComponentOverviewLayout
@page "/component-overview"

@inject DlgService DlgService

@inject ArticleBrandFacade ArticleBrandFacade
@inject ArticleCategoryFacade ArticleCategoryFacade
@inject DealerInfoFacade DealerFacade
@inject ArticleFacade ArticleFacade

<PageTitle>component-overview</PageTitle>

<MudPaper Outlined="false" Elevation="0" Class="d-flex flex-column gap-2 px-5">


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="DlgService.DealerCreateAsync">
        <MudButton FullWidth
                   OnClick="@(() => DlgService.DealerCreateAsync())">
            <MudText>Create</MudText>
        </MudButton>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="DealerList">
        <DealerList />
    </ComponentOverviewComponent>


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="DlgService.ArticleCreateAsync">
        <MudButton FullWidth
                   OnClick="@(() => DlgService.ArticleCreateAsync("23E2903D-0D02-4632-85E5-374F62FE6BA5"))">
            <MudText>Create</MudText>
        </MudButton>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="DealerList">
        <ArticleList OnArticleClick="@(x => DlgService.ArticleModifyAsync(x.Id))" />
    </ComponentOverviewComponent>


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="Article Brand Dlg">
        <MudButton FullWidth
                   OnClick="@(() => DlgService.ArticleBrandCreateAsync())">
            <MudText>RUN</MudText>
        </MudButton>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleBrandSelection">
        <ArticleBrandSelection Value="@_articleBrandValue"
                               ValueChanged="@(x => _articleBrandValue = x)" />
        <MudText>@_articleBrandValue</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleBrandList">
        <ArticleBrandList ElementClick="@(x => DlgService.ArticleBrandModifyAsync(x.Id))" />
    </ComponentOverviewComponent>


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="Article Category Dlg">
        <MudButton FullWidth
                   OnClick="@(() => DlgService.ArticleCategoryCreateAsync())">
            <MudText>CREATE</MudText>
        </MudButton>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleCategorySelection">
        <ArticleCategorySelection @bind-Value="_articleCategoryValue" />
        <MudText>@_articleCategoryValue</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleCategoryList">
        <ArticleCategoryList ElementClick="@(x => DlgService.ArticleCategoryModifyAsync(x.Id))" />
    </ComponentOverviewComponent>

</MudPaper>

@code {
    private string _articleCategoryValue = "Head";
    private string _articleBrandValue = "Head";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ArticleBrandFacade.FetchAll();
        ArticleCategoryFacade.FetchAll();
        DealerFacade.ReLoadAllDealer();
        ArticleFacade.FetchAll();
    }
}
