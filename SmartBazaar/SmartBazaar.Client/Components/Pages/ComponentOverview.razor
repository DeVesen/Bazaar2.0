    }

    private async Task<IEnumerable<DvAutocompleteSelect.SelectorItem>> SearchFuncAsync(string searchValue, CancellationToken cancellationToken)
    {
        await Task.Delay(200, cancellationToken);

        return string.IsNullOrWhiteSpace(searchValue)
            ? _autocompleteElements
            : _autocompleteElements
                .Where(e => e.Caption.Contains(searchValue, StringComparison.OrdinalIgnoreCase))
                .OrderBy(p => p.Caption);
    }

    private async Task<DvAutocompleteSelect.SelectorItem?> AddFuncAsync(string value)
    {
        await Task.Delay(200);

        var newElement = new DvAutocompleteSelect.SelectorItem { Caption = value };

        _autocompleteElements.Add(newElement);

        return newElement;
    }

    private static string ToJsonString(object obj)
    {
        var options = new JsonSerializerOptions
        {
            WriteIndented = true
        };

        var result = JsonSerializer.Serialize(obj, options);

        return result;
    }
