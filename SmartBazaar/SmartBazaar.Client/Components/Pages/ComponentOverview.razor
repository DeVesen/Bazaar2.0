<PageTitle>component-overview</PageTitle>

<MudPaper Outlined="false" Elevation="0" Class="d-flex flex-column gap-2 px-5">
    @* 

    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="ArticleCreateForm">
        <ArticleCreateForm IsValidChanged="@(x => _articleCreateIsValid = x)"
                           @bind-Article="_articleCreate" />
        <MudText>@ToJsonString(new { Valid = _articleCreateIsValid, Article = _articleCreate })</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleUpdateForm">
        <ArticleUpdateForm IsValidChanged="@(x => _articleUpdateIsValid = x)"
                           @bind-Article="_articleUpdate"/>
        <MudText>@ToJsonString(new { Valid = _articleUpdateIsValid, Article = _articleUpdate })</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleDescriptionForm">
        <ArticleDescriptionForm IsValidChanged="@(x => _articleDescriptionIsValid = x)"
                                IsTouchedChanged="@(x => _articleDescriptionIsTouched = x)"
                                @bind-Item="_articleDescription" />
        <MudText>@ToJsonString(new { Valid = _articleDescriptionIsValid, Touched = _articleDescriptionIsTouched, ArticleDescription = _articleDescription })</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticlePriceForm">
        <ArticlePriceForm IsValidChanged="@(x => _articlePriceIsValid = x)"
                          IsTouchedChanged="@(x => _articlePriceIsTouched = x)"
                          @bind-Item="_articlePrice" />
        <MudText>@ToJsonString(new { Valid = _articlePriceIsValid, Touched = _articlePriceIsTouched, ArticlePrice = _articlePrice })</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleStatusForm">
        <ArticleStatusForm IsValidChanged="@(x => _articleStatusIsValid = x)"
                           IsTouchedChanged="@(x => _articleStatusIsTouched = x)"
                           @bind-Item="_articleStatus" />
        <MudText>@ToJsonString(new { Valid = _articleStatusIsValid, Touched = _articleStatusIsTouched, ArticleStatus = _articleStatus })</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleList">
        <ArticleList ArticleListItems="@_articleListItemElements" />
    </ComponentOverviewComponent>


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="DealerForm">
        <DealerForm @bind-Item="_dealerElement"/>
    </ComponentOverviewComponent>

   *@

    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />

    <ComponentOverviewComponent ComponentName="Article Brand Dlg">
        <MudButton FullWidth
                   OnClick="@(() => DlgService.ArticleBrandCreate())">
            <MudText>RUN</MudText>
        </MudButton>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleBrandForm">
        <ArticleBrandForm @bind-Item="_articleBrand"/>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleBrandSelection">
        <ArticleBrandSelection Value="@_articleBrandValue"
                               ValueChanged="@(x => _articleBrandValue = x)" />
        <MudText>@_articleBrandValue</MudText>
    </ComponentOverviewComponent>
    
    <ComponentOverviewComponent ComponentName="ArticleBrandList">
        <ArticleBrandList ElementClick="@(element => DlgService.ArticleBrandModify(element))" />
    </ComponentOverviewComponent>


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />
    

    <ComponentOverviewComponent ComponentName="Article Category Dlg">
        <MudButton FullWidth
                   OnClick="@(() => DlgService.ArticleCategoryCreate())">
            <MudText>CREATE</MudText>
        </MudButton>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleCategoryForm">
        <ArticleCategoryForm @bind-Item="_articleCategory" />
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleCategorySelection">
        <ArticleCategorySelection @bind-Value="_articleCategoryValue" />
        <MudText>@_articleCategoryValue</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="ArticleCategoryList">
        <ArticleCategoryList ElementClick="@(element => DlgService.ArticleCategoryModify(element))" />
    </ComponentOverviewComponent>

    @* 
    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="DvTextField">
        <DvTextField T="string"
                     Label="Please enter hear:"
                     HelperText="Hier kannst du etwas eingeben..."
                     @bind-Value="_dvTextFieldValue" />

        <MudText>@(string.IsNullOrWhiteSpace(_dvTextFieldValue) ? "<no input>" : _dvTextFieldValue)</MudText>
    </ComponentOverviewComponent>


    <MudDivider DividerType="DividerType.FullWidth" Style="height: 2px" Class="mt-2 mb-2" />


    <ComponentOverviewComponent ComponentName="AutocompleteSelect">
        <DvAutocompleteSelect Label="Auto-Complete-Select"
                              SearchFunc="SearchFuncAsync"
                              @bind-Value="_selectedAutocomplete" />

        <MudText>@(_selectedAutocomplete != null ? _selectedAutocomplete.Caption : "<no selection>")</MudText>
    </ComponentOverviewComponent>

    <ComponentOverviewComponent ComponentName="AutocompleteSelect">
        <DvAutocompleteSelect Label="Auto-Complete-Select"
                              SearchFunc="SearchFuncAsync"
                              AddFunc="AddFuncAsync"
                              @bind-Value="_selectedAutocomplete" />

        <MudText>@(_selectedAutocomplete != null ? _selectedAutocomplete.Caption : "<no selection>")</MudText>
    </ComponentOverviewComponent> *@
</MudPaper>

