@using SmartBazaar.Client.Services
@using SmartBazaar.Shared.Contracts
@using SmartBazaar.Shared.Extensions
@using SmartBazaar.Shared.Models
@using SmartBazaar.Shared.Types
@using SmartBazaar.Shared.Validator

@inject IArticleService ArticleService
@inject DlgService DlgService
@inject ArticleModifyValidator ArticleValidator
@inject SnackBarService SnackBarService

<MudDialog>
    <TitleContent>
        <MudGrid Spacing="0">
            <MudItem xs="8" sm="10">
                <MudText Typo="Typo.h6">Artikel ändern</MudText>
            </MudItem>
            <MudItem xs="2" sm="1">
                <MudIconButton Icon="@Icons.Material.Filled.Article"
                               OnClick="@(() => _selectedTab = TabSelectionItemType.Data)" />
            </MudItem>
            <MudItem xs="2" sm="1">
                <MudIconButton Icon="@Icons.Material.Filled.PointOfSale"
                               OnClick="@(() => _selectedTab = TabSelectionItemType.Status)" />
            </MudItem>
        </MudGrid>
    </TitleContent>
    <DialogContent>
        @if(_selectedTab == TabSelectionItemType.Data)
        {
            <ArticleForm Item="@_model"
                         ItemChanged="@(x => OnAfterModelChangedAsync(x))"
                         Validation="@ArticleValidator.Validate"
                         IsUpdate="true"/>
        }
        else
        {
            <ArticleStatusForm @bind-Item="_model.Status"
                               @bind-Item:after="OnAfterModelChangedAsync" />
        }
    </DialogContent>
    <DialogActions>
        <MudGrid Spacing="1">
            <MudItem xs="4" Class="d-flex justify-center">
                <DvButtonSave Disabled="@(_inputIsValid is false)" OnClick="SubmitAsync"/>
            </MudItem>
            <MudItem xs="4" Class="d-flex justify-center">
                <DvButtonDelete IconOnly OnClick="DeleteAsync" />
            </MudItem>
            <MudItem xs="4" Class="d-flex justify-center">
                <DvButtonCancel OnClick="@(() => MudDialog.Cancel())"/>
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>

@code {
    private bool _inputIsValid;
    private ArticleModel _model = null!;
    private TabSelectionItemType _selectedTab = TabSelectionItemType.Data;

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string ArticleId { get; set; } = null!;


    protected override async Task OnInitializedAsync()
    {
        var result = await ArticleService.GetByIdAsync(ArticleId);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim laden des Artikels:\r\n{result.ErrorMessage}");
            MudDialog.Cancel();
            return;
        }
        _model = result.Value;
    }


    private async Task OnAfterModelChangedAsync()
    {
        var validationResult = await ArticleValidator.ValidateAsync(_model);
        _inputIsValid = validationResult.IsValid;
    }

    private async Task OnAfterModelChangedAsync(ArticleDataModel data)
    {
        _model.Adapt(data);

        var validationResult = await ArticleValidator.ValidateAsync(_model);
        _inputIsValid = validationResult.IsValid;

        await OnAfterModelChangedAsync();
    }

    private async Task SubmitAsync()
    {
        var result = await ArticleService.UpdateAsync(_model);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim speichern:\r\n{result.ErrorMessage}");
            return;
        }
        
        SnackBarService.AddInfo($"Artikel {_model.Number} geändert ...");
        MudDialog.Close(DialogResult.Ok(result.Value.Id));
    }

    private async Task DeleteAsync()
    {
        var questionResult = await DlgService.ShowMessageBoxAsync($"Artikel {_model.Number} wirklich löschen?", "Löschen", "Löschen", "Nein");
        if (questionResult != MessageBoxResultType.Yes)
        {
            return;
        }

        var result = await ArticleService.DeleteAsync(_model.Id);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim löschen:\r\n{result.ErrorMessage}");
            return;
        }
        
        SnackBarService.AddInfo($"Artikel {_model.Number} gelöscht ...");
        MudDialog.Close(DialogResult.Ok(_model.Id));
    }


    private enum TabSelectionItemType
    {
        Data,
        Status
    }
}
