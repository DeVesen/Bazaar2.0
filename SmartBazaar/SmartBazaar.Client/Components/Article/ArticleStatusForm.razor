@using SmartBazaar.Shared.Extensions
@using SmartBazaar.Shared.Models

<MudGrid Spacing="2">
    <MudItem xs="12">
        <MudField Label="Erstellt um:"
        Variant="Variant.Filled">
            <MudText Align="Align.Center" Style="height: 24px;">
                @GetDateTimeFormated(Item.Created)
            </MudText>
        </MudField>
    </MudItem>

    <MudItem xs="12">
        <MudField Label="Freigegeben um:"
        Variant="Variant.Filled"
        Adornment="@ShowApprovedAdornment()"
        AdornmentIcon="@GetApprovedAdornmentIcon()"
        OnAdornmentClick="OnApprovedAdornmentClicked">
            <MudText Align="Align.Center" Style="height: 24px;">
                @GetDateTimeFormated(Item.ApprovedForSale)
            </MudText>
        </MudField>
    </MudItem>

    <MudItem xs="12">
        <MudField Label="Verkauft um:"
        Variant="Variant.Filled"
        Adornment="@ShowSoldAdornment()"
        AdornmentIcon="@Icons.Material.TwoTone.Delete"
        OnAdornmentClick="@(_ => Item.Sold = null)">
            <MudText Align="Align.Center" Style="height: 24px;">
                @GetDateTimeFormated(Item.Sold)
            </MudText>
        </MudField>
    </MudItem>

    <MudItem xs="12">
        <MudField Label="Zurückgegeben um:"
        Variant="Variant.Filled"
        Adornment="@ShowReturnedAdornment()"
        AdornmentIcon="@GetReturnedAdornmentIcon()"
        OnAdornmentClick="OnReturnedAdornmentClicked">
            <MudText Align="Align.Center" Style="height: 24px;">
                @GetDateTimeFormated(Item.Returned)
            </MudText>
        </MudField>
    </MudItem>

    <MudItem xs="12">
        <MudField Label="Abgerechnet um:"
        Variant="Variant.Filled"
        Adornment="@ShowSettledAdornment()"
        AdornmentIcon="@Icons.Material.TwoTone.Delete"
        OnAdornmentClick="OnSettledAdornmentClicked">
            <MudText Align="Align.Center" Style="height: 24px;">
                @GetDateTimeFormated(Item.Settled)
            </MudText>
        </MudField>

    </MudItem>
</MudGrid>

@code {

    [Parameter]
    public required ArticleStatus Item { get; set; }

    [Parameter]
    public required EventCallback<ArticleStatus> ItemChanged { get; set; }


    private async Task OnFormFieldChangedAsync()
    {
        await ItemChanged.InvokeAsync(Item);
    }


    private Adornment ShowApprovedAdornment()
    {
        return Item.IsInSale() || Item.IsApprovedForSale() is false
            ? Adornment.End
            : Adornment.None;
    }

    private Adornment ShowSoldAdornment()
    {
        return Item.IsSold() && Item.IsReturned() is false && Item.IsSettled() is false
            ? Adornment.End
            : Adornment.None;
    }

    private Adornment ShowReturnedAdornment()
    {
        return Item.IsApprovedForSale() && Item.IsSold() is false && Item.IsSettled() is false
            ? Adornment.End
            : Adornment.None;
    }

    private Adornment ShowSettledAdornment()
    {
        return Item.IsSettled()
            ? Adornment.End
            : Adornment.None;
    }


    private string GetApprovedAdornmentIcon()
    {
        return Item.ApprovedForSale.HasValue
            ? Icons.Material.TwoTone.Delete
            : Icons.Material.TwoTone.KeyboardReturn;
    }

    private string GetReturnedAdornmentIcon()
    {
        return Item.Returned.HasValue
            ? Icons.Material.TwoTone.Delete
            : Icons.Material.TwoTone.KeyboardReturn;
    }

    private string GetSettledAdornmentIcon()
    {
        return Item.Settled.HasValue
            ? Icons.Material.TwoTone.Delete
            : Icons.Material.TwoTone.KeyboardReturn;
    }


    private void OnApprovedAdornmentClicked()
    {
        if (Item.IsApprovedForSale() is false)
        {
            Item.ApprovedForSale = DateTime.Now;
        }
        else
        {
            Item.ApprovedForSale = null;
        }

        ItemChanged.InvokeAsync(Item);
    }

    private void OnReturnedAdornmentClicked()
    {
        if (Item.IsReturned() is false)
        {
            Item.Returned = DateTime.Now;
        }
        else
        {
            Item.Returned = null;
        }

        ItemChanged.InvokeAsync(Item);
    }

    private void OnSettledAdornmentClicked()
    {
        Item.Settled = null;

        ItemChanged.InvokeAsync(Item);
    }


    private static string GetDateTimeFormated(DateTime? dt)
    {
        return dt.HasValue
            ? dt.Value.ToString("dd.MM.yyyy HH:mm:ss")
            : string.Empty;
    }
}
