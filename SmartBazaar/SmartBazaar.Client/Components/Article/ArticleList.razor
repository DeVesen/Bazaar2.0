@using Fluxor
@using SmartBazaar.Client.States.ArticleState
@using SmartBazaar.Client.States.DealerInfoState
@using SmartBazaar.Shared.Models
@inherits Fluxor.Blazor.Web.Components.FluxorComponent

@inject IState<DealerInfoState> DealerState
@inject IState<ArticleState> ArticleState

<style>
    .article-list-row:hover {
    background-color: #cccccc !important;
    }

    .mud-data-grid .mud-table-cell.sticky-left {
    background-color: transparent !important;
    }
</style>

<MudDataGrid T="ArticleListItem"
             Hover
             Dense
             Items="@ArticleElements"
             RowClick="OnRowClickAsync"
             RowClass="article-list-row">
    <Columns>
        <PropertyColumn Property="x => x.Number"
                        Title="#"
                        Resizable="false" 
                        StickyLeft="true"
                        CellStyle="width: 100px;" />
        <PropertyColumn Property="x => x.ArticleBrand"
                        Title="Hersteller"
                        Resizable="false"
                        CellStyle="width: 125px;" />
        <PropertyColumn Property="x => x.ArticleCategory"
                        Title="Kategorie"
                        Resizable="false"
                        CellStyle="width: 125px;" />
        <PropertyColumn Property="x => x.Title"
                        Title="Description" />
        <PropertyColumn Property="@(x => $"{x.Price01} €")"
                        Title="Preis"
                        Resizable="false"
                        CellStyle="width: 100px;" />
        <PropertyColumn Property="x => x.Vendor"
                        Title="Verkäufer"
                        CellStyle="width: 150px;" />
        <PropertyColumn Property="x => x.Vendor"
                        Title="Status"
                        CellStyle="width: 150px;" />
    </Columns>
</MudDataGrid>

@code {
    private string _searchString = "";

    private IEnumerable<ArticleListItem> ArticleElements
        => ArticleState.GetAll().Select(p => new ArticleListItem
            {
                Vendor = DealerState.GetDealerNameById(p.DealerId),
                Number = p.Number,
                ArticleBrand = p.Description.ArticleBrand,
                ArticleCategory = p.Description.ArticleCategory,
                Title = p.Description.Description,
                Price01 = p.Price.Price01,
                Price02 = p.Price.Price02,
                Status = string.Empty,
                Model = p
            }).OrderBy(p => p.Title).ToArray();

    public bool IsDataLoading => DealerState.IsLoading() || ArticleState.IsLoading();

    [Parameter]
    public EventCallback<ArticleModel> OnArticleClick { get; set; }


    private async Task OnRowClickAsync(DataGridRowClickEventArgs<ArticleListItem> row)
    {
        await OnArticleClick.InvokeAsync(row.Item.Model);
    }

    private bool FilterFunc(ArticleListItem element)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
        {
            return true;
        }

        var searchParts = _searchString.Split(" ", StringSplitOptions.RemoveEmptyEntries)
                                       .Where(p => string.IsNullOrWhiteSpace(p) is false)
                                       .ToArray();

        return searchParts.All(p => FilterPart(element, p));
    }

    private bool FilterPart(ArticleListItem element, string filterPart)
    {
        if (element.Number.Contains(filterPart, StringComparison.OrdinalIgnoreCase))
            return true;

        if (element.Vendor.Contains(filterPart, StringComparison.OrdinalIgnoreCase))
            return true;

        if (element.ArticleBrand.Contains(filterPart, StringComparison.OrdinalIgnoreCase))
            return true;

        if (element.ArticleCategory.Contains(filterPart, StringComparison.OrdinalIgnoreCase))
            return true;

        if (element.Title.Contains(filterPart, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }


    public class ArticleListItem
    {
        public required string Vendor { get; init; }

        public required string Number { get; init; }
        public required string ArticleBrand { get; init; }
        public required string ArticleCategory { get; init; }
        public required string Title { get; init; }

        public required double Price01 { get; init; }
        public required double? Price02 { get; init; }

        public required string Status { get; init; }
        
        public required ArticleModel Model { get; init; }
    }
}
