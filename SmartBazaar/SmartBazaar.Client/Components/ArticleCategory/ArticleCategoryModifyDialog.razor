@using SmartBazaar.Client.Services
@using SmartBazaar.Shared.Contracts
@using SmartBazaar.Shared.Extensions
@using SmartBazaar.Shared.Models
@using SmartBazaar.Shared.Types
@using SmartBazaar.Shared.Validator

@inject IArticleCategoryService ArticleCategoryService
@inject DlgService DlgService
@inject ArticleCategoryValidator ArticleCategoryValidator
@inject SnackBarService SnackBarService

<MudDialog>
    <DialogContent>
        <ArticleCategoryForm Item="@_model"
                             ItemChanged="OnAfterModelChangedAsync" />
    </DialogContent>
    <DialogActions>
        <MudGrid Spacing="1">
            <MudItem xs="4" Class="d-flex justify-center">
                <DvButtonSave Disabled="@(_inputIsValid is false)" OnClick="SubmitAsync" />
            </MudItem>
            <MudItem xs="4" Class="d-flex justify-center">
                <DvButtonDelete IconOnly OnClick="DeleteAsync" />
            </MudItem>
            <MudItem xs="4" Class="d-flex justify-center">
                <DvButtonCancel OnClick="@(() => MudDialog.Cancel())" />
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>

@code {
    private bool _inputIsValid;
    private ArticleCategoryModel _model = null!;


    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string ArticleCategoryId { get; set; } = null!;


    protected override async Task OnInitializedAsync()
    {
        var result = await ArticleCategoryService.GetByIdAsync(ArticleCategoryId);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim laden der Kategorie:\r\n{result.ErrorMessage}");
            MudDialog.Cancel();
            return;
        }
        _model = result.Value;
    }


    private async Task OnAfterModelChangedAsync(ArticleCategoryDataModel data)
    {
        _model.Adapt(data);
        _inputIsValid = (await ArticleCategoryValidator.ValidateAsync(_model)).IsValid;
    }

    private async Task SubmitAsync()
    {
        var result = await ArticleCategoryService.UpdateAsync(_model);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim speichern:\r\n{result.ErrorMessage}");
            return;
        }
        
        SnackBarService.AddInfo($"Hersteller {_model.Title} geändert ...");
        MudDialog.Close(DialogResult.Ok(result.Value.Id));
    }

    private async Task DeleteAsync()
    {
        var questionResult = await DlgService.ShowMessageBoxAsync($"Kategorie {_model.Title} wirklich löschen?", "Löschen", "Löschen", "Nein");
        if (questionResult != MessageBoxResultType.Yes)
        {
            return;
        }

        var result = await ArticleCategoryService.DeleteAsync(_model.Id);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim löschen:\r\n{result.ErrorMessage}");
            return;
        }
        
        SnackBarService.AddInfo($"Hersteller {_model.Title} gelöscht ...");
        MudDialog.Close(DialogResult.Ok(_model.Id));
    }
}
