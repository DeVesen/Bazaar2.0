@using SmartBazaar.Shared.Models
@using SmartBazaar.Shared.Validator

@inject ArticleCategoryValidator ArticleCategoryValidator

<MudForm FieldChanged="OnFormFieldChangedAsync"
         Model="Item"
         Validation="@ArticleCategoryValidator.Validate"
         Style="margin-bottom: 20px;">

    <MudGrid Spacing="2">
        <MudItem xs="12">
            <DvTextField T="string"
                         Required
                         Label="Bezeichnung"
                         @bind-Value="Item.Title"
                         For="@(() => Item.Title)" />
        </MudItem>
    </MudGrid>

</MudForm>

@code {
    [Parameter]
    public required ArticleCategoryDataModel Item { get; set; }

    [Parameter]
    public required EventCallback<ArticleCategoryDataModel> ItemChanged { get; set; }

    private async Task OnFormFieldChangedAsync()
    {
        await ItemChanged.InvokeAsync(Item);
    }
}
