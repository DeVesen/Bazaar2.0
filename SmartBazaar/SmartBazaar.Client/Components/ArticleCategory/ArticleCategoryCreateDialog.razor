@using SmartBazaar.Client.Models
@using SmartBazaar.Client.Services

@inject IArticleCategoryService ArticleCategoryService
@inject ISnackBarService SnackBarService

<MudDialog>
    <DialogContent>
        <ArticleCategoryForm @bind-Item="_articleCategory"
                             IsValidChanged="@(x => _inputIsValid = x)"
                             IsTouchedChanged="@(x => _inputIsTouched = x)" />
        </DialogContent>
    <DialogActions>
        <DvButtonSave Disabled="@((_inputIsValid && _inputIsTouched) is false)"
                      OnClick="SubmitAsync" />
        <DvButtonCancel OnClick="@(() => MudDialog.Cancel())" />
    </DialogActions>
</MudDialog>

@code {
    private bool _inputIsValid;
    private bool _inputIsTouched;

    private ArticleCategory _articleCategory = ArticleCategory.CreateEmptyNew();

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    private async Task SubmitAsync()
    {
        var result = await ArticleCategoryService.CreateAsync(_articleCategory);

        if (result.IsSuccess)
        {
            SnackBarService.AddInfo($"Kategorie {_articleCategory.Title} erstellt ...");

            MudDialog.Close(DialogResult.Ok(result.Value.Id));
        }
    }
}
