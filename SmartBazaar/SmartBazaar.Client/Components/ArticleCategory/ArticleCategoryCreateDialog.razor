@using SmartBazaar.Client.Services
@using SmartBazaar.Shared.Contracts
@using SmartBazaar.Shared.Extensions
@using SmartBazaar.Shared.Models
@using SmartBazaar.Shared.Validator

@inject IArticleCategoryService ArticleCategoryService
@inject ArticleCategoryValidator ArticleCategoryValidator
@inject SnackBarService SnackBarService

<MudDialog>
    <DialogContent>
        <ArticleCategoryForm Item="@_model"
                             ItemChanged="OnAfterModelChangedAsync"/>
    </DialogContent>
    <DialogActions>
        <DvButtonSave Disabled="@(_inputIsValid is false)"
        OnClick="SubmitAsync" />
        <DvButtonCancel OnClick="@(() => MudDialog.Cancel())" />
    </DialogActions>
</MudDialog>

@code {
    private bool _inputIsValid;

    private ArticleCategoryCreateModel _model = new();

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; } = null!;

    private async Task OnAfterModelChangedAsync(ArticleCategoryDataModel data)
    {
        _model.Adapt(data);
        _inputIsValid = (await ArticleCategoryValidator.ValidateAsync(_model)).IsValid;
    }

    private async Task SubmitAsync()
    {
        var result = await ArticleCategoryService.CreateAsync(_model);
        if (result.IsSuccess is false)
        {
            SnackBarService.AddInfo($"Fehler beim erstellen:\r\n{result.ErrorMessage}");
            return;
        }
        
        SnackBarService.AddInfo($"Kategorie {_model.Title} erstellt ...");
        MudDialog.Close(DialogResult.Ok(result.Value.Id));
    }
}
