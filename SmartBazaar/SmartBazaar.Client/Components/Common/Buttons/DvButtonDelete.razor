@if (IconOnly)
{
    <MudButton Size="@Size"
               Variant="@Variant"
               Color="@Color"
               Disabled="@Disabled"
               OnClick="OnClick"
               Style="@Style">
        <MudIcon Icon="@BazaarIcons.Delete"
                 Size="@(IconSize ?? Size)" />
    </MudButton>
}
else
{
    <MudButton FullWidth="@FullWidth"
               StartIcon="@BazaarIcons.Delete"
               IconSize="@(IconSize ?? Size)"
               Size="@Size"
               Variant="@Variant"
               Color="@Color"
               Disabled="@Disabled"
               OnClick="OnClick"
               Style="@Style">
        <MudText Align="Align.Center">Löschen</MudText>
    </MudButton>
}

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool FullWidth { get; set; } = true;

    [Parameter]
    public Size? IconSize { get; set; } = Size.Medium;

    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter]
    public Color Color { get; set; } = Color.Error;

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public bool IconOnly { get; set; } = false;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
}
