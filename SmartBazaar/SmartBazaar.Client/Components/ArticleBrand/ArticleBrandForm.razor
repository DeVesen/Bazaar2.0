@using SmartBazaar.Shared.Models
@using SmartBazaar.Shared.Validator

@inject ArticleBrandValidator ArticleBrandValidator

<MudForm FieldChanged="@(async _ => await ItemChanged.InvokeAsync(Item))"
         Model="Item"
         Validation="@ArticleBrandValidator.Validate"
         Style="margin-bottom: 20px;">

    <MudGrid Spacing="2">
        <MudItem xs="12">
            <DvTextField T="string"
                         Required
                         Label="Bezeichnung"
                         @bind-Value="Item.Title"
                         For="@(() => Item.Title)" />
        </MudItem>
    </MudGrid>

</MudForm>

@code {
    [Parameter]
    public required ArticleBrandDataModel Item { get; set; }

    [Parameter]
    public required EventCallback<ArticleBrandDataModel> ItemChanged { get; set; }

    [Parameter]
    public object? Validation { get; set; }
}
